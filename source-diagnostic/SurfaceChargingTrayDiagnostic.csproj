<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SurfaceChargingTrayDiagnostic</RootNamespace>
    <AssemblyName>SurfaceChargingTrayDiagnostic</AssemblyName>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Surface Charging Tray Diagnostic</Product>
    <Authors>Keyokku</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- WMI for device info + brightness levels -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
