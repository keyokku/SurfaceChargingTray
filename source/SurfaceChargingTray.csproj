<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\plug-white.ico</ApplicationIcon>
    <RootNamespace>SurfaceChargingTray</RootNamespace>
    <AssemblyName>SurfaceChargingTray</AssemblyName>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>Surface Charging Tray</Product>
    <Authors>Keyokku</Authors>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\plug-white.ico">
      <LogicalName>plug-white.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\plug-black.ico">
      <LogicalName>plug-black.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\error-red.ico">
      <LogicalName>error-red.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
